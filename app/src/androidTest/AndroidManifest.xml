<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application>
        <!-- Availability-only fixture for idle screenshots; never included in the app APK. -->
        <service
            android:name="com.nameemrooz.journal.StoreAvailabilityRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
        <receiver android:name="com.nameemrooz.journal.StreamingScriptReceiver" android:exported="true" />
        <service android:name="com.nameemrooz.journal.StreamingRecognitionService" android:exported="true" android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
    </application>
</manifest>
